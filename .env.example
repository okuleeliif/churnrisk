# ==============================================================================
# ChurnLens - Ortam degiskenleri ornegi
# Kullanmak icin bu dosyayi ".env" adiyla kopyalayin ve degerleri doldurun:
#     cp .env.example .env
# .env dosyasi .gitignore'da oldugu icin GitHub'a YUKLENMEZ.
# Hicbir sey ayarlamazsaniz uygulama varsayilan olarak CSV modunda calisir.
# ==============================================================================

# Veri kaynagi: csv (varsayilan) | sql | bigquery
CHURNLENS_DATA_SOURCE=csv

# --- CSV modu ---
CHURNLENS_CSV_PATH=data/saas_churn_data.csv

# --- SQL modu (Postgres / MySQL / SQLite) ---
# Once ek paketleri kurun:  pip install sqlalchemy psycopg2-binary   (MySQL icin: pymysql)
# CHURNLENS_SQL_CONN=postgresql+psycopg2://kullanici:sifre@localhost:5432/veritabani
# CHURNLENS_SQL_CONN=mysql+pymysql://kullanici:sifre@localhost:3306/veritabani
# CHURNLENS_SQL_CONN=sqlite:///local.db
# CHURNLENS_SQL_TABLE=customers_churn
# CHURNLENS_SQL_QUERY=SELECT * FROM customers_churn_view

# --- BigQuery modu ---
# Once ek paketleri kurun:  pip install google-cloud-bigquery db-dtypes
# Kimlik dogrulama icin GOOGLE_APPLICATION_CREDENTIALS bir service account JSON dosyasini gostermeli.
# CHURNLENS_BQ_PROJECT=my-gcp-project
# CHURNLENS_BQ_QUERY=SELECT * FROM `my-gcp-project.dataset.churn_view`
